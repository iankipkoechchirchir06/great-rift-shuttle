<% const title = 'Driver Dashboard - Great Rift Shuttle'; %>
<%- include('dashboard-header') %>
<div class="dashboard-wrapper">
  <%- include('dashboard-aside', { activePage: 'driver-dashboard' }) %>
  <main class="dashboard-main">
    <div class="dashboard-header">
      <div>
        <p class="driver-eyebrow">DRIVER PORTAL</p>
        <h1>Welcome back, <%= user.username %></h1>
        <p class="driver-header-subtitle">Keep track of your scheduled shuttle assignments.</p>
      </div>
      <a class="btn btn-primary btn-sm" href="/drivertrips">View all trips</a>
    </div>
    <div class="stats-container">
      <div class="stat-card driver-stat-card"><span class="stat-icon">🚌</span><p class="stat-label">Assigned Trips</p><p class="stat-value"><%= trips.length %></p><p class="stat-subtitle">All assignments</p></div>
      <div class="stat-card driver-stat-card"><span class="stat-icon">⏳</span><p class="stat-label">Upcoming Trips</p><p class="stat-value"><%= upcomingTrips.length %></p><p class="stat-subtitle">Ready for departure</p></div>
      <div class="stat-card driver-stat-card"><span class="stat-icon">✓</span><p class="stat-label">Account Status</p><p class="stat-value driver-status-value">Active</p><p class="stat-subtitle">Good standing</p></div>
    </div>
    <div class="dashboard-card">
      <div class="driver-card-heading"><div><p class="driver-eyebrow">SCHEDULE</p><h2>Upcoming assignments</h2></div><a href="/drivertrips">See all</a></div>
      <% if (upcomingTrips.length === 0) { %><div class="driver-empty-state"><span>🚌</span><h3>No upcoming trips</h3><p>Your next assignments will appear here.</p></div><% } %>
      <div class="driver-assignment-list">
        <% upcomingTrips.slice(0, 5).forEach(trip => { %>
          <div class="driver-assignment"><div class="driver-route-icon">→</div><div class="driver-assignment-main"><h3><%= trip.origin %> <span>to</span> <%= trip.destination %></h3><p><strong>Departure:</strong> <%= new Date(trip.departure_time).toLocaleString() %></p></div><span class="status-badge status-<%= trip.status %>"><%= trip.status.replace('_', ' ') %></span></div>
        <% }) %>
      </div>
    </div>
  </main>
</div>
<%- include('dashboard-footer') %>
