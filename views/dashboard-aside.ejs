<!-- Dashboard Sidebar Navigation -->
<aside class="dashboard-sidebar" id="dashboardSidebar">
  <!-- User Profile -->
  <div class="sidebar-profile">
    <div class="profile-avatar"><%= (user.username)[0].toUpperCase() %></div>
    <div class="profile-info">
      <h4><%= user.username %></h4>
      <p><%= user.role === 'driver' ? 'Driver' : 'Administrator' %></p>
    </div>
  </div>

  <!-- Navigation Menu -->
  <nav class="dashboard-menu">
    <% if (user.role === 'driver') { %>
    <a
      href="/driverdashboard"
      class="dashboard-menu-item<%= activePage === 'driver-dashboard' ? ' active' : '' %>"
    >
      <span class="menu-icon">📊</span>
      <span class="menu-label">Driver Dashboard</span>
    </a>
    <a
      href="/drivertrips"
      class="dashboard-menu-item<%= activePage === 'driver-trips' ? ' active' : '' %>"
    >
      <span class="menu-icon">🚌</span>
      <span class="menu-label">My Trips</span>
    </a>
    <a
      href="/driverprofile"
      class="dashboard-menu-item<%= activePage === 'driver-profile' ? ' active' : '' %>"
    >
      <span class="menu-icon">👤</span>
      <span class="menu-label">My Profile</span>
    </a>
    <% } else { %>
    <a
      href="/admindashboard"
      class="dashboard-menu-item<%= activePage === 'overview' ? ' active' : '' %>"
    >
      <span class="menu-icon">📊</span>
      <span class="menu-label">Overview</span>
    </a>

    <a
      href="/admintrips"
      class="dashboard-menu-item<%= activePage === 'trips' ? ' active' : '' %>"
    >
      <span class="menu-icon">🚌</span>
      <span class="menu-label">Manage Trips</span>
    </a>

    <a
      href="/adminbookings"
      class="dashboard-menu-item<%= activePage === 'bookings' ? ' active' : '' %>"
    >
      <span class="menu-icon">🎫</span>
      <span class="menu-label">Manage Bookings</span>
    </a>

    <a
      href="/adminroutes"
      class="dashboard-menu-item<%= activePage === 'routes' ? ' active' : '' %>"
    >
      <span class="menu-icon">🗺️</span>
      <span class="menu-label">Manage Routes</span>
    </a>

    <a
      href="/admindrivers"
      class="dashboard-menu-item<%= activePage === 'drivers' ? ' active' : '' %>"
    >
      <span class="menu-icon">👨‍💼</span>
      <span class="menu-label">Manage Drivers</span>
    </a>

    <a
      href="/adminvehicles"
      class="dashboard-menu-item<%= activePage === 'vehicles' ? ' active' : '' %>"
    >
      <span class="menu-icon">🚐</span>
      <span class="menu-label">Manage Vehicles</span>
    </a>

    <a
      href="/adminpayments"
      class="dashboard-menu-item<%= activePage === 'payments' ? ' active' : '' %>"
    >
      <span class="menu-icon">💳</span>
      <span class="menu-label">Manage Payments</span>
    </a>
    <% } %>

    <a href="/logout" class="dashboard-menu-item logout-btn">
      <span class="menu-icon">🚪</span>
      <span class="menu-label">Logout</span>
    </a>
  </nav>
</aside>

<script>
  const dashboardMenuToggle = document.getElementById("dashboardMenuToggle");
  const dashboardSidebar = document.getElementById("dashboardSidebar");
  const dashboardSidebarBackdrop = document.getElementById("dashboardSidebarBackdrop");

  function closeDashboardMenu() {
    dashboardSidebar.classList.remove("active");
    dashboardSidebarBackdrop.classList.remove("active");
    dashboardMenuToggle.setAttribute("aria-expanded", "false");
  }

  dashboardMenuToggle.addEventListener("click", () => {
    const isOpen = dashboardSidebar.classList.toggle("active");
    dashboardSidebarBackdrop.classList.toggle("active", isOpen);
    dashboardMenuToggle.setAttribute("aria-expanded", String(isOpen));
  });

  dashboardSidebarBackdrop.addEventListener("click", closeDashboardMenu);
  dashboardSidebar.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", closeDashboardMenu);
  });
</script>
