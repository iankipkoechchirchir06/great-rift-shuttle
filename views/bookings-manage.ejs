<% const title = 'Manage Bookings - Great Rift Shuttle'; %>
<%- include('dashboard-header') %>

<div class="dashboard-wrapper">
  <%- include('dashboard-aside', { activePage: 'bookings' }) %>

  <!-- Main Content -->
  <main class="dashboard-main">
    <div class="dashboard-header">
      <h1>Manage Bookings</h1>
      <div class="header-actions">
        <button class="btn btn-primary btn-sm" type="button" onclick="openBookingModal()">+ New Booking</button>
      </div>
    </div>

    <% if (bookingSuccess) { %>
      <div class="alert alert-success">Booking created successfully.</div>
    <% } %>
    <% if (bookingError) { %>
      <div class="alert alert-error"><%= bookingError %></div>
    <% } %>

    <div id="newBookingModal" class="modal">
      <div class="modal-content">
        <div class="modal-header">
          <h2>Book a Trip</h2>
          <button class="modal-close" type="button" onclick="closeBookingModal()">&times;</button>
        </div>
        <form action="/add-booking" method="post" class="modal-form">
          <div class="group">
            <label for="tripId">Trip</label>
            <select id="tripId" name="trip_id" required>
              <option value="">-- Choose Trip --</option>
              <% trips.forEach(trip => { %>
                <option value="<%= trip.trip_id %>">
                  <%= trip.origin %> → <%= trip.destination %> |
                  <%= new Date(trip.departure_time).toLocaleString() %> |
                  <%= trip.capacity - trip.booked_seats %> seats left
                </option>
              <% }) %>
            </select>
          </div>
          <div class="group">
            <label for="seatNumber">Seat Number</label>
            <input type="number" id="seatNumber" name="seat_number" min="1" required />
          </div>
          <div class="group">
            <label for="clientName">Passenger Name</label>
            <input type="text" id="clientName" name="client_name" required />
          </div>
          <div class="group">
            <label for="clientPhone">Passenger Phone</label>
            <input type="tel" id="clientPhone" name="client_phone" required />
          </div>
          <div class="group">
            <label for="clientEmail">Passenger Email</label>
            <input type="email" id="clientEmail" name="client_email" />
          </div>
          <div class="modal-footer">
            <button class="btn btn-secondary" type="button" onclick="closeBookingModal()">Cancel</button>
            <button class="btn btn-primary" type="submit">Create Booking</button>
          </div>
        </form>
      </div>
    </div>

    <div class="dashboard-card">
      <h2>All Bookings</h2>

      <div class="card-controls">
        <div class="search-box">
          <input type="text" placeholder="Search bookings by ID or route..." />
        </div>
        <div class="filter-group">
          <select>
            <option>All Status</option>
            <option>Confirmed</option>
            <option>Pending</option>
            <option>Completed</option>
            <option>Cancelled</option>
          </select>
        </div>
      </div>

      <div class="trips-table-wrapper">
        <table class="data-table">
          <thead>
            <tr><th>ID</th><th>Passenger</th><th>Route</th><th>Departure</th><th>Seat</th><th>Payment</th></tr>
          </thead>
          <tbody>
            <% if (bookings.length === 0) { %>
              <tr><td colspan="6">No bookings found.</td></tr>
            <% } %>
            <% bookings.forEach(booking => { %>
              <tr>
                <td><%= booking.booking_id %></td>
                <td><%= booking.client_name %><br><small><%= booking.client_phone %></small></td>
                <td><%= booking.origin %> → <%= booking.destination %></td>
                <td><%= new Date(booking.departure_time).toLocaleString() %></td>
                <td><%= booking.seat_number %></td>
                <td><%= booking.payment_status %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</div>

<script>
  function openBookingModal() {
    document.getElementById("newBookingModal").classList.add("show");
  }

  function closeBookingModal() {
    document.getElementById("newBookingModal").classList.remove("show");
  }
</script>

<%- include('dashboard-footer') %>
